{
  "app-id": "org.kde.jira-quick-task",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.7",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.PySide.BaseApp",
  "base-version": "6.7",
  "command": "jira-quick-task",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--socket=session-bus",
    "--filesystem=xdg-config/jira-quick-task:create",
    "--filesystem=xdg-data/jira-quick-task:create",
    "--filesystem=home:ro",
    "--filesystem=host-etc:ro",
    "--talk-name=org.freedesktop.portal.*",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Notifications",
    "--own-name=org.kde.jira-quick-task"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/cmake",
    "/share/pkgconfig",
    "/share/cmake",
    "*.a",
    "*.la"
  ],
  "modules": [
    "python3-requests.json",
    "python3-pytz.json",
    "python3-pyyaml.json",
    "python3-xlib.json",
    {
      "name": "jira-quick-task",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-build-isolation --prefix=/app .",
        "cp org.kde.jira-quick-task.desktop.in org.kde.jira-quick-task.desktop",
        "install -Dm644 org.kde.jira-quick-task.desktop /app/share/applications/org.kde.jira-quick-task.desktop",
        "mkdir -p /app/share/jira-quick-task/config",
        "cp config/.jira-config.yml.example /app/share/jira-quick-task/config/.jira-config.yml.example || true",
        "cp config/config.json.example /app/share/jira-quick-task/config/config.json.example || true",
        "cp config/.jira-config.yml.example /app/share/jira-quick-task/config/.jira-config.yml || true",
        "cp config/config.json.example /app/share/jira-quick-task/config/config.json || true",
        "install -Dm644 assets/jira-quick-task.svg /app/share/icons/hicolor/scalable/apps/org.kde.jira-quick-task.svg || true",
        "mkdir -p /app/share/jira-quick-task/assets || true",
        "install -Dm644 assets/short.ogg /app/share/jira-quick-task/assets/short.ogg || true",
        "install -Dm644 assets/short.mp3 /app/share/jira-quick-task/assets/short.mp3 || true",
        "install -Dm644 assets/long.ogg /app/share/jira-quick-task/assets/long.ogg || true",
        "install -Dm644 assets/long.mp3 /app/share/jira-quick-task/assets/long.mp3 || true",
        "install -Dm755 flatpak-wrapper.sh /app/bin/jira-quick-task || true",
        "mkdir -p /app/scripts/lib || true",
        "cp scripts/lib/common.sh /app/scripts/lib/common.sh || true"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ],
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh"
  ]
}