# Dockerfile para desenvolvimento e testes
FROM ubuntu:24.04

# Evitar prompts interativos durante instalação
ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3-pip \
    python3-dev \
    python3-xlib \
    xvfb \
    # Bibliotecas X11/XCB
    libxcb-xinerama0 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    libxkbcommon0 \
    libxrender1 \
    libfontconfig1 \
    libdbus-1-3 \
    # Bibliotecas GLib (necessárias para Qt/PySide6)
    libglib2.0-0 \
    libglib2.0-dev \
    # Outras dependências do Qt
    libicu-dev \
    libpcre2-16-0 \
    libdouble-conversion3 \
    libharfbuzz0b \
    libfreetype6 \
    libpng16-16 \
    libjpeg-turbo8 \
    # Bibliotecas OpenGL/EGL (necessárias para Qt GUI)
    libegl1 \
    libgl1 \
    libgles2 \
    libglx0 \
    libx11-6 \
    libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/*

# Criar diretório de trabalho
WORKDIR /app

# Copiar requirements primeiro (para cache do Docker)
COPY requirements.txt .

# Instalar PySide6 e dependências Python via pip
# PySide6 não está disponível via apt no Ubuntu 24.04, então usamos pip
# --break-system-packages é necessário devido ao PEP 668 (externally-managed-environment)
# No Docker isso é seguro, pois o container é isolado
RUN pip3 install --no-cache-dir --break-system-packages \
    PySide6>=6.6.0 \
    && pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Copiar código do projeto
COPY . .

# Definir variáveis de ambiente para testes
ENV QT_QPA_PLATFORM=offscreen
ENV DISPLAY=:99

# Comando padrão (pode ser sobrescrito)
CMD ["python3", "-m", "pytest", "tests/", "-v"]
