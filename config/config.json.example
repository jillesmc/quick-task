{
  "project": "PLATFORM",
  "issue_type": "Task",
  "assignee": "auto",
  "custom_fields": {
    "tipo_atividade": "customfield_12088",
    "documentacao_anexa": "customfield_14840",
    "utilizacao_ia": "customfield_14841",
    "valor_entregue": "customfield_XXXXX",
    "plataformas_afetadas": "customfield_YYYYY"
  },
  "tipo_atividade_values": [
    "Novas iniciativas/Novas funcionalidades/Melhorias funcionais",
    "Melhorias Técnicas/Atualizações Técnicas/Plataforma/Segurança",
    "Suporte Dúvidas/Suporte uso incorreto",
    "Bugs/Incidentes/Retrabalho Técnico",
    "Mudança de escopo"
  ],
  "status_sequence": [
    "TO DO",
    "IN PROGRESS",
    "DONE"
  ],
  "assets": {
    "cloud_id": null,
    "object_type_id_valor_entregue": 434,
    "object_type_id_plataformas_afetadas": 441,
    "object_type_valor_entregue": null,
    "object_type_plataformas_afetadas": null
  },
  "worklog_timezone": "America/Sao_Paulo",
  "worklog": {
    "retroactive_max_hours": 24,
    "default_durations": [30, 60, 120, 240, 480]
  },
  "pomodoro": {
    "enabled": true,
    "pomodoro_duration_minutes": 25,
    "short_break_minutes": 5,
    "long_break_minutes": 15,
    "pomodoros_before_long_break": 4,
    "auto_continue_timeout_seconds": 30,
    "notifications": {
      "enabled": true,
      "sound_enabled": false,
      "desktop_notifications": true,
      "short_sound_file": "short",
      "long_sound_file": "long",
      "return_from_break_sound_file": null
    }
  },
  "epic_filters": {
    "created_by_me": false,
    "assigned_to_me": false,
    "project_platform": true,
    "exclude_done": true
  },
  "parent_work_item_filters": {
    "created_by_me": false,
    "assigned_to_me": false,
    "project_platform": true,
    "exclude_done": true,
    "selected_project_keys": []
  },
  "status_transitions": {
    "worklog_check": {
      "enabled": true,
      "show_confirmation_dialog": true,
      "block_transition_if_pending": false
    }
  },
  "timesheet": {
    "enabled": true,
    "cache_ttl_minutes": 1440,
    "default_period": "last_7_days",
    "max_results": 500
  },
  "attachments": {
    "max_file_size_mb": 10,
    "allowed_image_extensions": ["png", "jpg", "jpeg", "gif", "webp"],
    "allowed_document_extensions": ["pdf", "txt", "md", "json", "yaml", "xml", "log"],
    "embed": {
      "enabled": true,
      "images": {
        "embed_as_media": true,
        "default_layout": "center",
        "max_display_width": 760
      },
      "videos": { "embed_as_media": true },
      "other_files": { "embed_as_link": true }
    }
  },
  "github": {
    "token": "",
    "username": ""
  },
  "development_panel": {
    "enabled": true,
    "github_enrichment": false,
    "default_org": ""
  },
  "google_oauth": {
    "client_id": "",
    "project_id": "",
    "client_secret": ""
  },
  "google": {
    "drive_comments": {
      "enabled": true,
      "max_comments": 50,
      "unresolved_only": true
    }
  },
  "voice_input": {
    "enabled": false,
    "localai_base_url": "http://localhost:8080",
    "localai_whisper_model": "whisper-pt-br",
    "localai_llm_model": "qwen-3b-pt",
    "localai_task_system_prompt": "Você é um assistente técnico especializado em análise e formalização de demandas.\nReceberá um texto curto e coloquial que descreve uma tarefa, uma ideia ou problema técnico.\nSua função é transformar esse texto em uma task bem definida para o Jira, redigida em linguagem clara, profissional e objetiva.\n\nAo gerar a resposta:\n- Reescreva o texto como se fosse a descrição de uma issue no Jira.\n- Expanda qualquer parte vaga ou informal, interpretando o contexto técnico de forma plausível.\n- Se houver conceitos complexos, decomponha‑os em partes menores e mais simples.\n- Inclua seções com títulos claros, por exemplo:\n-- Título: resumo curto da atividade.\n-- Descrição detalhada: explique o objetivo, o contexto e a motivação.\n-- Critérios de aceitação: defina quando a tarefa será considerada concluída.\n-- Subtarefas sugeridas (opcional): liste etapas ou blocos lógicos para execução.\n- Mantenha o texto direto, com tom técnico e neutro (sem gírias ou informalidades).",
    "localai_comment_improvement_prompt": "Você é um assistente técnico especializado em comunicação profissional dentro de ambientes de engenharia de software.\nReceberá um comentário escrito de forma coloquial ou resumida, como se fosse uma nota rápida de desenvolvedor.\nSua tarefa é reescrever esse comentário para que fique adequado ao padrão profissional de comunicação no Jira, mantendo clareza, concisão e tom neutro.\nAo gerar a resposta:\n- Reescreva o comentário em português formal, mas natural (sem exageros burocráticos).\n- Expanda termos técnicos, abreviações e ideias implícitas, tornando o raciocínio claro para qualquer colega técnico.\n- Mantenha o estilo de comunicação colaborativo e construtivo — adequado a equipes de engenharia e revisões de tasks.\n- Se houver argumentos técnicos ou decisões, explique o porquê brevemente.\n- Se o comentário incluir dúvidas ou pedidos, formule-os de forma educada e direta.\n- Evite redundância, jargão desnecessário e gírias.\n- Preserve o sentido original da mensagem do autor, apenas aprimorando clareza e tom.\n\nQuando possível, organize o texto em pequenos parágrafos ou marcadores, de modo que fique fácil de ler dentro do Jira.",
    "language": "pt",
    "max_recording_seconds": 120,
    "keyboard_shortcut": "Meta+F",
    "auto_process_after_stop": false,
    "microphone_device": "default"
  }
}
