auth_type: basic
board:
    id: 1856
    name: PLATFORM Board
    type: kanban
epic:
    name: customfield_10011
    link: customfield_10014
installation: Cloud
issue:
    fields:
        custom:
            - name: Documentacao anexa
              key: customfield_14840
              schema:
                datatype: option
            - name: Utilizacao de IA
              key: customfield_14841
              schema:
                datatype: option
            - name: Tipo de atividade
              key: customfield_12088
              schema:
                datatype: option
            - name: Clockwork Timer
              key: customfield_10196
              schema:
                datatype: string
    types:
        - id: "10046"
          name: Initiative
          handle: Initiative
          subtask: false
        - id: "10006"
          name: Epic
          handle: Epic
          subtask: false
        - id: "10294"
          name: Technical Debt
          handle: Technical Debt
          subtask: false
        - id: "10008"
          name: Task
          handle: Task
          subtask: false
        - id: "10007"
          name: Story
          handle: Story
          subtask: false
        - id: "10004"
          name: Bug
          handle: Bug
          subtask: false
        - id: "10261"
          name: Spike
          handle: Spike
          subtask: false
        - id: "10003"
          name: Sub-task
          handle: Sub-task
          subtask: true
# IMPORTANTE: Este é um arquivo template.
# Para criar o arquivo de configuração:
#   1. Copie este arquivo: cp config/.jira-config.yml.example config/.jira-config.yml
#   2. Edite o arquivo e preencha os campos abaixo:
#      - login: Seu e-mail do Jira
#      - server: URL do seu servidor Jira (ex: https://seu-projeto.atlassian.net)
#      - token: Token de API (obtenha em https://id.atlassian.com/manage-profile/security/api-tokens)
#   3. A aplicação usa Jira REST API v3. O token é lido apenas deste arquivo (não usa variáveis de ambiente).
#
login: # PREENCHA COM SEU EMAIL AQUI
project:
    key: PLATFORM
    type: classic
server: # PREENCHA COM A URL DO SEU SERVIDOR JIRA AQUI (ex: https://seu-projeto.atlassian.net)
token: # PREENCHA COM SEU TOKEN DE API JIRA (obtenha em https://id.atlassian.com/manage-profile/security/api-tokens)
timezone: America/Sao_Paulo
